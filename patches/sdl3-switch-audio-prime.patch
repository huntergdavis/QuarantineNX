+static bool SWITCHAUDIO_MarkReleased(SDL_AudioDevice *device, AudioOutBuffer *released, u32 count)
+{
+    // libnx requests space for a single returned buffer pointer. Refuse an
+    // unexpected result rather than guessing which storage can be reused.
+    if (count != 1 || !released) {
+        return SDL_SetError("Unexpected Switch audio release count");
+    }
+    for (int i = 0; i < NUM_AUDIO_BUFFERS; i++) {
+        if (released == &device->hidden->buffers[i] && device->hidden->queued[i]) {
+            device->hidden->queued[i] = false;
+            return true;
+        }
+    }
+    return SDL_SetError("Unknown or duplicate Switch audio buffer release");
